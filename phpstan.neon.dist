includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 4
    # The CI matrix spans Filament ^4.0|^5.0 — some ignores only match on
    # one major, which must not fail the other.
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # The trait is consumer-facing package API; nothing inside this package uses it.
        - identifier: trait.unused
          path: src/Concerns/HasAddress.php
        - identifier: trait.unused
          path: src/Resources/Concerns/SearchesAddressGlobally.php
