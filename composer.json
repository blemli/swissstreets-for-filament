{
    "name": "blemli/swissstreets-for-filament",
    "description": "Every Swiss address. Offline.",
    "keywords": [
        "blemli",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "swissstreets",
        "swiss",
        "address",
        "switzerland",
        "egid",
        "swissstreets-for-filament"
    ],
    "homepage": "https://github.com/blemli/swissstreets-for-filament",
    "support": {
        "issues": "https://github.com/blemli/swissstreets-for-filament/issues",
        "source": "https://github.com/blemli/swissstreets-for-filament"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "blemli",
            "email": "apps@problem.li",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-health": "^1.40"
    },
    "autoload": {
        "psr-4": {
            "Blemli\\Swissstreets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blemli\\Swissstreets\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blemli\\Swissstreets\\SwissstreetsServiceProvider"
            ],
            "aliases": {
                "Swissstreets": "Blemli\\Swissstreets\\Facades\\Swissstreets"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
